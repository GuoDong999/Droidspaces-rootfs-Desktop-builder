[Desktop Entry]
Name=Steam
GenericName=Gaming Platform
Comment=Application for managing and playing games on Steam
Exec=/usr/local/bin/steam %U
Icon=steam
Terminal=false
Type=Application
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
Actions=BigPicture;Community;Library;Friends;News;Settings;

[Desktop Action BigPicture]
Name=Big Picture
Name[zh_CN]=大屏幕模式
Exec=/usr/local/bin/steamos-session

[Desktop Action Community]
Name=Community
Name[zh_CN]=社区
Exec=/usr/local/bin/steam steam://url/SteamIDControlPage

[Desktop Action Library]
Name=Library
Name[zh_CN]=库
Exec=/usr/local/bin/steam steam://open/games

[Desktop Action Friends]
Name=Friends
Name[zh_CN]=好友
Exec=/usr/local/bin/steam steam://open/friends

[Desktop Action News]
Name=News
Name[zh_CN]=新闻
Exec=/usr/local/bin/steam steam://open/news

[Desktop Action Settings]
Name=Settings
Name[zh_CN]=设置
Exec=/usr/local/bin/steam steam://open/settings
EOF